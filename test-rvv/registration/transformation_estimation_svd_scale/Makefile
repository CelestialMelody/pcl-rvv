generate_qemu_smoke_evidence_manifest: $(BENCH_COMPARE_OUTPUT_FILE)
	$(PYTHON) script/generate_tesvd_scale_qemu_evidence_manifest.py \
		--std-log $(BENCH_STD_OUTPUT_FILE) \
		--rvv-log $(BENCH_RVV_OUTPUT_FILE) \
		--summary-md $(BENCH_COMPARE_OUTPUT_FILE) \
		--asm $(ASM_DIR)/$(ARCH)/$(TARGET_BENCH_RVV).asm \
		--output $(QEMU_SMOKE_EVIDENCE_MANIFEST)

run_qemu_smoke_evidence_doctor: generate_qemu_smoke_evidence_manifest
	$(PYTHON) ../../script/evidence_doctor.py \
		--manifest $(QEMU_SMOKE_EVIDENCE_MANIFEST) \
		--output $(QEMU_SMOKE_EVIDENCE_DOCTOR_MD) \
		--fail-on never

record_qemu_correctness_state:
	$(PYTHON) ../../script/evidence_registry.py record \
		--registry $(EVIDENCE_REGISTRY) \
		--path $(TEST_STD_OUTPUT_FILE) \
		--path $(TEST_RVV_OUTPUT_FILE) \
		--target run_test_compare \
		--backend qemu \
		--run-label $(TESVD_SCALE_QEMU_CORRECTNESS_RUN_LABEL) \
		--case-filter all-correctness \
		--evidence-role qemu_correctness \
		--doc-ref README.zh.md \
		--doc-ref doc/transformation_estimation_svd_scale-evaluation.zh.md \
		--doc-ref doc/phases/000-current-state-and-gaps/result.zh.md \
		--doc-ref doc/phases/010-production-integration-plan/result.zh.md \
		--doc-ref doc/phases/020-matrix-local-scale-simplification/result.zh.md \
		--doc-ref doc/phases/030-pi5-user-confirmation-packet/result.zh.md \
		--doc-ref doc/phases/031-adoption-closeout-plan/result.zh.md \
		--doc-ref doc/phases/040-generic-point-type-expansion/result.zh.md \
		--doc-ref doc/phases/043-row-source-expansion/result.zh.md \
		--doc-ref doc/phases/044-row-source-generic-xyz-point-type-expansion/result.zh.md \
		--doc-ref doc/phases/047-correspondence-sorted-copy-production-probe/result.zh.md \
		--doc-ref doc/phases/049-dual-indexed-target-sorted-detail-ab/result.zh.md \
		--doc-ref doc/phases/050-matrix-local-adoption-closeout/result.zh.md \
		--doc-ref doc/phases/051-more-generic-xyz-aos-point-types/result.zh.md \
		--doc-ref doc/phases/052-more-generic-xyz-aos-board/result.zh.md \
		--doc-ref doc/phases/053-row-source-more-generic-xyz-aos-point-types/result.zh.md \
		--doc-ref doc/phases/054-row-source-all-more-generic-xyz-aos-matrix/result.zh.md \
		--doc-ref doc/phases/055-custom-xyz-aos-layout-sampling/result.zh.md \
		--doc-ref doc/phases/056-custom-row-source-large-variance-profile/result.zh.md \
