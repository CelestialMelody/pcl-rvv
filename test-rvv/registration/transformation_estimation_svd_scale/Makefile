collect_board_bench_ordered_cloud_pair_repeated: deploy_board | $(TESVD_SCALE_BOARD_REPEATED_DIR)
	@for run in $$(seq 1 $(TESVD_SCALE_BOARD_REPEATED_RUNS)); do \
		run_id=$$(printf "%02d" "$$run"); \
		remote_dir="$(REMOTE_DIR)/log/board/$(TESVD_SCALE_BOARD_RUN_LABEL)/run-$$run_id"; \
		local_dir="$(TESVD_SCALE_BOARD_REPEATED_DIR)/run-$$run_id"; \
		mkdir -p "$$local_dir"; \
		echo "[BOARD] svd-scale ordered-cloud-pair repeated run $$run_id/$(TESVD_SCALE_BOARD_REPEATED_RUNS)"; \
		$(SSH_CMD) $(REMOTE_USER)@$(REMOTE_IP) "cd $(REMOTE_DIR) && $(MAKE) run_bench_compare REMOTE_OUTPUT_DIR='$$remote_dir' BENCH_COMPARE_SAVE='$$remote_dir/analyze_bench_compare.log' BOARD_LABEL='$(BOARD_LABEL)' REMOTE_BENCH_ARGS='--case-filter ordered-cloud-pair --iterations $(TESVD_SCALE_BOARD_BENCH_ITERATIONS) --warmup-iterations $(TESVD_SCALE_BOARD_BENCH_WARMUP_ITERATIONS)'"; \
		rsync -e "$(RSYNC_SSH)" -avzP $(REMOTE_USER)@$(REMOTE_IP):$$remote_dir/ "$$local_dir/"; \
	done

