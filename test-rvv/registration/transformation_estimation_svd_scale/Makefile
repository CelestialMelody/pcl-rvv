record_qemu_scalar_double_diagnostic_scout_state:
	@$(MAKE) -C $(CURDIR) run_bench_compare \
		ALLOW_QEMU_BENCH_COMPARE=1 \
		BENCH_ARGS="--case-filter scalar-double-diagnostic-scout --iterations 3 --warmup-iterations 1"
	$(PYTHON) ../../script/evidence_registry.py record \
		--registry $(EVIDENCE_REGISTRY) \
		--path $(BENCH_STD_OUTPUT_FILE) \
		--path $(BENCH_RVV_OUTPUT_FILE) \
		--summary $(BENCH_COMPARE_OUTPUT_FILE) \
