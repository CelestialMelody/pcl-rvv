collect_board_bench_generic_xyz_point_types_repeated: deploy_board | $(TE2D_BOARD_GENERIC_REPEATED_DIR)
	@rm -rf "$(TE2D_BOARD_GENERIC_REPEATED_DIR)"/run-*
	@for run in $$(seq 1 $(TE2D_BOARD_REPEATED_RUNS)); do \
		run_id=$$(printf "%02d" "$$run"); \
		remote_dir="$(REMOTE_DIR)/log/board/$(TE2D_BOARD_GENERIC_RUN_LABEL)/run-$$run_id"; \
		local_dir="$(TE2D_BOARD_GENERIC_REPEATED_DIR)/run-$$run_id"; \
		mkdir -p "$$local_dir"; \
		echo "[BOARD] generic_xyz_point_types repeated run $$run_id/$(TE2D_BOARD_REPEATED_RUNS)"; \
		$(SSH_CMD) $(REMOTE_USER)@$(REMOTE_IP) "cd $(REMOTE_DIR) && $(MAKE) run_bench_compare REMOTE_OUTPUT_DIR='$$remote_dir' BENCH_COMPARE_SAVE='$$remote_dir/analyze_bench_compare.log' BOARD_LABEL='$(BOARD_LABEL)' REMOTE_BENCH_ARGS='--case-filter generic-xyz-point-types --iterations $(TE2D_BOARD_BENCH_ITERATIONS) --warmup-iterations $(TE2D_BOARD_BENCH_WARMUP_ITERATIONS)'"; \
		rsync -e "$(RSYNC_SSH)" -avzP $(REMOTE_USER)@$(REMOTE_IP):$$remote_dir/ "$$local_dir/"; \
	done

